# OCRdoc Environment Configuration
# Copy file này thành .env và điều chỉnh theo máy của bạn

# ── Engine Selection ──────────────────────────────────────
PADDLE_DEVICE=gpu          # "gpu" hoặc "cpu"
SURYA_DEVICE=cuda          # "cuda" hoặc "cpu"
VRAM_LIMIT_MB=7000         # Giới hạn VRAM (để lại 1GB headroom)

# ── Model Paths ───────────────────────────────────────────
PADDLE_MODEL_DIR=models/paddle
SURYA_MODEL_DIR=models/surya

# ── Preprocessing ─────────────────────────────────────────
DEFAULT_DPI=300            # DPI khi convert PDF
MAX_PDF_PAGES=100          # Giới hạn số trang PDF

# ── API Server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── PDF (Windows) ─────────────────────────────────────────
# POPPLER_PATH=C:\poppler\Library\bin
# Nếu để trống, sẽ tự động tìm trong PATH hoặc dùng PyMuPDF
